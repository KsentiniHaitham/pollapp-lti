# ══════════════════════════════════════════════════════════════
#  PollApp LTI — Variables d'environnement
#  Copie ce fichier en ".env" et remplis chaque valeur.
# ══════════════════════════════════════════════════════════════

# ── NODE ──────────────────────────────────────────────────────
NODE_ENV=production          # "production" ou "development"
PORT=3000                    # Railway remplace automatiquement cette valeur

# ── LTIJS ─────────────────────────────────────────────────────
# Clé de chiffrement des cookies LTI (min. 32 caractères aléatoires)
# Génère une valeur avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LTI_KEY=CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING

# ── MONGODB ATLAS ─────────────────────────────────────────────
# Récupère l'URL de connexion sur https://cloud.mongodb.com
# Format : mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pollapp
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pollapp

# ── ADMIN ─────────────────────────────────────────────────────
# Clé secrète pour les routes admin (/api/platform, /api/platforms)
# Génère une valeur avec : node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_KEY=CHANGE_THIS_ADMIN_KEY
